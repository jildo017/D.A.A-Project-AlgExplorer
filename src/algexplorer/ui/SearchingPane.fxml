<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="algexplorer.ui.SearchingPane" stylesheets="@UITheme.css" prefWidth="1080" prefHeight="720">
    <padding>
        <Insets top="14" right="20" bottom="14" left="20"/>
    </padding>

    <!-- Top: Header & Algorithm Selector -->
    <top>
        <VBox spacing="10">
            <HBox alignment="CENTER_LEFT" spacing="14">
                <Button fx:id="backBtn" text="← Dashboard" styleClass="btn-secondary"/>
                <Label text="🔍 Searching Visualizer" styleClass="section-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <HBox spacing="10" alignment="CENTER_RIGHT">
                    <VBox styleClass="stat-pill" alignment="CENTER">
                        <Label text="ALGORITHM" styleClass="stat-label"/>
                        <Label fx:id="algoNameStat" text="Linear Search" styleClass="stat-value"/>
                    </VBox>
                    <VBox styleClass="stat-pill" alignment="CENTER">
                        <Label text="TIME COMPLEXITY" styleClass="stat-label"/>
                        <Label fx:id="algoComplexityStat" text="O(n)" styleClass="stat-value"/>
                    </VBox>
                    <Button fx:id="exitBtn" text="Exit App" styleClass="btn-danger"/>
                </HBox>
            </HBox>

            <!-- 4 Search Algorithms Selector -->
            <HBox alignment="CENTER" spacing="12" styleClass="surface-accent">
                <Button fx:id="btnLinear" text="1. Linear Search" styleClass="algo-btn"/>
                <Button fx:id="btnBinary" text="2. Binary Search" styleClass="algo-btn"/>
                <Button fx:id="btnJump" text="3. Jump Search" styleClass="algo-btn"/>
                <Button fx:id="btnInterpolation" text="4. Interpolation Search" styleClass="algo-btn"/>
            </HBox>
        </VBox>
    </top>

    <!-- Center: Input, Canvas, Telemetry & Controls -->
    <center>
        <VBox spacing="10">
            <padding>
                <Insets top="8" right="0" bottom="8" left="0"/>
            </padding>

            <!-- Configuration Bar -->
            <HBox alignment="CENTER_LEFT" spacing="12" styleClass="surface-accent">
                <Label text="Search Target Key:" styleClass="stat-label"/>
                <TextField fx:id="targetInput" text="52" prefWidth="65" styleClass="text-input-dark"/>
                <Button fx:id="applyTargetBtn" text="Set Target" styleClass="btn-secondary"/>

                <Separator orientation="VERTICAL"/>

                <Label text="Array:" styleClass="stat-label"/>
                <TextField fx:id="arrayInput" text="5, 12, 19, 24, 31, 38, 45, 52, 60, 68, 77, 85, 93, 102, 115, 128" HBox.hgrow="ALWAYS" styleClass="text-input-dark"/>
                <Button fx:id="loadArrayBtn" text="Load Array" styleClass="btn-secondary"/>
                <Button fx:id="randomArrayBtn" text="Random Sorted" styleClass="btn-secondary"/>
            </HBox>

            <!-- Main Canvas Viewport -->
            <StackPane styleClass="canvas-box" VBox.vgrow="ALWAYS" minHeight="280">
                <Canvas fx:id="canvas" width="1030" height="290"/>
            </StackPane>

            <!-- Status & Step Narration -->
            <HBox styleClass="desc-box" alignment="CENTER_LEFT" spacing="10">
                <Label text="SEARCH ACTION:" styleClass="stat-label"/>
                <Label fx:id="actionText" text="Ready. Select an algorithm and start search." styleClass="desc-text" HBox.hgrow="ALWAYS"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="stepCounterLabel" text="Step 0 / 0" styleClass="stat-value"/>
            </HBox>

            <!-- Playback Controls -->
            <HBox alignment="CENTER_LEFT" spacing="14" styleClass="surface-accent">
                <Button fx:id="playBtn" text="▶ Start Search" styleClass="btn-primary"/>
                <Button fx:id="stepBackBtn" text="⏮ Prev" styleClass="btn-secondary"/>
                <Button fx:id="stepForwardBtn" text="⏭ Next" styleClass="btn-secondary"/>
                <Button fx:id="resetBtn" text="↺ Reset" styleClass="btn-secondary"/>

                <Separator orientation="VERTICAL"/>

                <Label text="Pace:" styleClass="stat-label"/>
                <Slider fx:id="speedSlider" min="100" max="2000" value="700" prefWidth="140"/>
                <Label fx:id="speedValueLabel" text="700 ms" styleClass="stat-value"/>

                <Region HBox.hgrow="ALWAYS"/>

                <VBox alignment="CENTER">
                    <Label text="PROBES / CHECKS" styleClass="stat-label"/>
                    <Label fx:id="checksLabel" text="0" styleClass="stat-value"/>
                </VBox>
            </HBox>
        </VBox>
    </center>
</BorderPane>
