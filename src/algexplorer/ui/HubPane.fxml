<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="algexplorer.ui.HubPane" stylesheets="@UITheme.css" fx:id="rootPane" prefWidth="1180" prefHeight="750">

    <!-- Left Sidebar -->
    <left>
        <VBox prefWidth="185" minWidth="185" maxWidth="185" spacing="4" styleClass="sidebar">
            <padding>
                <Insets top="16" right="10" bottom="16" left="10"/>
            </padding>

            <!-- App Logo & Branding Header -->
            <HBox alignment="CENTER_LEFT" spacing="8">
                <padding>
                    <Insets top="0" right="0" bottom="14" left="4"/>
                </padding>
                <Label text="AE" styleClass="sidebar-logo-badge"/>
                <VBox spacing="1">
                    <Label text="Algorithm Explorer" styleClass="sidebar-app-name"/>
                    <Label text="Interactive Learning" styleClass="sidebar-sub-name"/>
                </VBox>
            </HBox>

            <!-- Dashboard Button (Active) -->
            <Button fx:id="navDashboard" text="Dashboard" styleClass="sidebar-item-active" maxWidth="Infinity" alignment="CENTER_LEFT"/>

            <!-- ALGORITHMS Group -->
            <Label text="ALGORITHMS" styleClass="sidebar-header-label"/>
            <Button fx:id="navSorting" text="Sorting" styleClass="sidebar-item" maxWidth="Infinity" alignment="CENTER_LEFT"/>
            <Button fx:id="navSearching" text="Searching" styleClass="sidebar-item" maxWidth="Infinity" alignment="CENTER_LEFT"/>
            <Button fx:id="navRecursion" text="Recursion" styleClass="sidebar-item" maxWidth="Infinity" alignment="CENTER_LEFT"/>
            <Button fx:id="navBenchmark" text="Benchmark" styleClass="sidebar-item" maxWidth="Infinity" alignment="CENTER_LEFT"/>

            <!-- DATA STRUCTURES Group -->
            <Label text="DATA STRUCTURES" styleClass="sidebar-header-label"/>
            <Button fx:id="navStack" text="Stack" styleClass="sidebar-item" maxWidth="Infinity" alignment="CENTER_LEFT"/>
            <Button fx:id="navQueue" text="Queue" styleClass="sidebar-item" maxWidth="Infinity" alignment="CENTER_LEFT"/>
            <Button fx:id="navLinkedList" text="Linked List" styleClass="sidebar-item" maxWidth="Infinity" alignment="CENTER_LEFT"/>
        </VBox>
    </left>

    <!-- Center Scrollable Content -->
    <center>
        <ScrollPane fx:id="scrollPane" fitToWidth="true" styleClass="scroll-pane-transparent">
            <VBox fx:id="mainContainer" spacing="22" styleClass="main-dashboard-body">
                <padding>
                    <Insets top="28" right="36" bottom="28" left="36"/>
                </padding>

                <!-- Page Header Title & Subtitle -->
                <VBox alignment="CENTER" spacing="6">
                    <Label text="Select an Algorithm or Data Structure" styleClass="dashboard-title"/>
                    <Label text="Interactive step-by-step visualizations. Choose a topic below to begin." styleClass="dashboard-subtitle"/>
                </VBox>

                <!-- Stats Counters Row: 21, 4, 0 -->
                <HBox alignment="CENTER" spacing="60">
                    <padding>
                        <Insets top="4" right="0" bottom="6" left="0"/>
                    </padding>
                    <VBox alignment="CENTER" spacing="2">
                        <Label text="21" styleClass="stat-big-number"/>
                        <Label text="Algorithms" styleClass="stat-sub-text"/>
                    </VBox>
                    <VBox alignment="CENTER" spacing="2">
                        <Label text="4" styleClass="stat-big-number"/>
                        <Label text="Categories" styleClass="stat-sub-text"/>
                    </VBox>
                    <VBox alignment="CENTER" spacing="2">
                        <Label text="0" styleClass="stat-big-number"/>
                        <Label text="Built-in sorts used" styleClass="stat-sub-text"/>
                    </VBox>
                </HBox>

                <!-- 6 Topic Cards in 2 rows of 3 -->
                <GridPane fx:id="cardsGrid" hgap="16" vgap="16" alignment="CENTER">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="33.33" hgrow="ALWAYS"/>
                        <ColumnConstraints percentWidth="33.33" hgrow="ALWAYS"/>
                        <ColumnConstraints percentWidth="33.33" hgrow="ALWAYS"/>
                    </columnConstraints>

                    <!-- Card 1: Sorting -->
                    <VBox fx:id="cardSorting" styleClass="overview-card" GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <HBox spacing="12" alignment="TOP_LEFT">
                            <StackPane styleClass="icon-box-purple">
                                <Label text="📊" styleClass="card-icon-emoji"/>
                            </StackPane>
                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                <HBox spacing="8" alignment="CENTER_LEFT">
                                    <Label text="Sorting" styleClass="card-title"/>
                                    <Label text="10 algos" styleClass="pill-badge-indigo"/>
                                </HBox>
                                <Label text="Bubble, Selection, Insertion, Shell, Merge, Quick, Heap, Counting, Radix, Bucket" styleClass="card-desc" wrapText="true"/>
                            </VBox>
                        </HBox>
                    </VBox>

                    <!-- Card 2: Searching -->
                    <VBox fx:id="cardSearching" styleClass="overview-card" GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <HBox spacing="12" alignment="TOP_LEFT">
                            <StackPane styleClass="icon-box-blue">
                                <Label text="🔍" styleClass="card-icon-emoji"/>
                            </StackPane>
                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                <HBox spacing="8" alignment="CENTER_LEFT">
                                    <Label text="Searching" styleClass="card-title"/>
                                    <Label text="4 algos" styleClass="pill-badge-indigo"/>
                                </HBox>
                                <Label text="Linear, Binary, Jump and Interpolation Search" styleClass="card-desc" wrapText="true"/>
                            </VBox>
                        </HBox>
                    </VBox>

                    <!-- Card 3: Data Structures -->
                    <VBox fx:id="cardStructures" styleClass="overview-card" GridPane.columnIndex="2" GridPane.rowIndex="0">
                        <HBox spacing="12" alignment="TOP_LEFT">
                            <StackPane styleClass="icon-box-teal">
                                <Label text="⛓" styleClass="card-icon-emoji"/>
                            </StackPane>
                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                <HBox spacing="8" alignment="CENTER_LEFT">
                                    <Label text="Data Structures" styleClass="card-title"/>
                                </HBox>
                                <Label text="Stack, Queue and Linked List with a log of every pointer move" styleClass="card-desc" wrapText="true"/>
                            </VBox>
                        </HBox>
                    </VBox>

                    <!-- Card 4: Recursion -->
                    <VBox fx:id="cardRecursion" styleClass="overview-card" GridPane.columnIndex="0" GridPane.rowIndex="1">
                        <HBox spacing="12" alignment="TOP_LEFT">
                            <StackPane styleClass="icon-box-orange">
                                <Label text="🔄" styleClass="card-icon-emoji"/>
                            </StackPane>
                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                <HBox spacing="8" alignment="CENTER_LEFT">
                                    <Label text="Recursion" styleClass="card-title"/>
                                    <Label text="4 algos" styleClass="pill-badge-indigo"/>
                                </HBox>
                                <Label text="Factorial, Fibonacci, Tower of Hanoi, Recursive Binary Search" styleClass="card-desc" wrapText="true"/>
                            </VBox>
                        </HBox>
                    </VBox>

                    <!-- Card 5: Benchmark -->
                    <VBox fx:id="cardBenchmark" styleClass="overview-card" GridPane.columnIndex="1" GridPane.rowIndex="1">
                        <HBox spacing="12" alignment="TOP_LEFT">
                            <StackPane styleClass="icon-box-green">
                                <Label text="📈" styleClass="card-icon-emoji"/>
                            </StackPane>
                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                <HBox spacing="8" alignment="CENTER_LEFT">
                                    <Label text="Benchmark" styleClass="card-title"/>
                                    <Label text="10 sorts" styleClass="pill-badge-indigo"/>
                                </HBox>
                                <Label text="Race all 10 sorting algorithms on the same random array" styleClass="card-desc" wrapText="true"/>
                            </VBox>
                        </HBox>
                    </VBox>

                    <!-- Card 6: Complexity -->
                    <VBox fx:id="cardComplexity" styleClass="overview-card" GridPane.columnIndex="2" GridPane.rowIndex="1">
                        <HBox spacing="12" alignment="TOP_LEFT">
                            <StackPane styleClass="icon-box-pink">
                                <Label text="O(n)" styleClass="card-icon-text"/>
                            </StackPane>
                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                <HBox spacing="8" alignment="CENTER_LEFT">
                                    <Label text="Complexity" styleClass="card-title"/>
                                    <Label text="Big-O" styleClass="pill-badge-indigo"/>
                                </HBox>
                                <Label text="Every screen shows Best, Average, Worst and Space complexity" styleClass="card-desc" wrapText="true"/>
                            </VBox>
                        </HBox>
                    </VBox>
                </GridPane>

                <!-- Section: Sorting Algorithms -->
                <VBox fx:id="sortingSection" spacing="12" styleClass="dashboard-section-card">
                    <padding>
                        <Insets top="18" right="20" bottom="18" left="20"/>
                    </padding>
                    <Label text="Sorting Algorithms" styleClass="section-card-title"/>
                    <FlowPane fx:id="sortingButtonsPane" hgap="10" vgap="10">
                        <Button fx:id="btnSortBubble" text="Bubble Sort" styleClass="btn-algo-action"/>
                        <Button fx:id="btnSortSelection" text="Selection Sort" styleClass="btn-algo-action"/>
                        <Button fx:id="btnSortInsertion" text="Insertion Sort" styleClass="btn-algo-action"/>
                        <Button fx:id="btnSortShell" text="Shell Sort" styleClass="btn-algo-action"/>
                        <Button fx:id="btnSortMerge" text="Merge Sort" styleClass="btn-algo-action"/>
                        <Button fx:id="btnSortQuick" text="Quick Sort" styleClass="btn-algo-action"/>
                        <Button fx:id="btnSortHeap" text="Heap Sort" styleClass="btn-algo-action"/>
                        <Button fx:id="btnSortCocktail" text="Cocktail Sort" styleClass="btn-algo-action"/>
                        <Button fx:id="btnSortCounting" text="Counting Sort" styleClass="btn-algo-action"/>
                        <Button fx:id="btnSortRadix" text="Radix Sort" styleClass="btn-algo-action"/>
                        <Button fx:id="btnSortBucket" text="Bucket Sort" styleClass="btn-algo-action"/>
                        <Button fx:id="btnSortCycle" text="Cycle Sort" styleClass="btn-algo-action"/>
                        <Button fx:id="btnSortTim" text="Tim Sort" styleClass="btn-algo-action"/>
                        <Button fx:id="btnSortPancake" text="Pancake Sort" styleClass="btn-algo-action"/>
                        <Button fx:id="btnSortComb" text="Comb Sort" styleClass="btn-algo-action"/>
                        <Button fx:id="btnSortGnome" text="Gnome Sort" styleClass="btn-algo-action"/>
                    </FlowPane>
                    <Button fx:id="btnBenchmarkAll" text="Benchmark All 10 Sorts" styleClass="btn-benchmark-wide" maxWidth="Infinity"/>
                </VBox>

                <!-- Section: Searching Algorithms -->
                <VBox fx:id="searchingSection" spacing="10" styleClass="dashboard-section-card">
                    <padding>
                        <Insets top="18" right="20" bottom="18" left="20"/>
                    </padding>
                    <Label text="Searching Algorithms" styleClass="section-card-title"/>
                    <Label text="Find a target in a list and see exactly which positions are checked." styleClass="section-card-desc"/>
                    <HBox spacing="12">
                        <Button fx:id="btnSearchLinear" text="Linear Search" styleClass="btn-algo-action" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        <Button fx:id="btnSearchBinary" text="Binary Search" styleClass="btn-algo-action" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        <Button fx:id="btnSearchJump" text="Jump Search" styleClass="btn-algo-action" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        <Button fx:id="btnSearchInterpolation" text="Interpolation Search" styleClass="btn-algo-action" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    </HBox>
                </VBox>

                <!-- Section: Data Structures -->
                <VBox fx:id="structuresSection" spacing="10" styleClass="dashboard-section-card">
                    <padding>
                        <Insets top="18" right="20" bottom="18" left="20"/>
                    </padding>
                    <Label text="Data Structures" styleClass="section-card-title"/>
                    <Label text="Built from linked nodes only. Every pointer change is logged." styleClass="section-card-desc"/>
                    <HBox spacing="12">
                        <Button fx:id="btnCustomStack" text="Custom Stack" styleClass="btn-algo-action" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        <Button fx:id="btnCustomQueue" text="Custom Queue" styleClass="btn-algo-action" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        <Button fx:id="btnCustomLinkedList" text="Custom Linked List" styleClass="btn-algo-action" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    </HBox>
                </VBox>

                <!-- Section: Recursion -->
                <VBox fx:id="recursionSection" spacing="10" styleClass="dashboard-section-card">
                    <padding>
                        <Insets top="18" right="20" bottom="18" left="20"/>
                    </padding>
                    <Label text="Recursion" styleClass="section-card-title"/>
                    <Label text="Follow every call, base case and return value." styleClass="section-card-desc"/>
                    <HBox spacing="12">
                        <Button fx:id="btnRecFactorial" text="Factorial" styleClass="btn-algo-action" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        <Button fx:id="btnRecFibonacci" text="Fibonacci" styleClass="btn-algo-action" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        <Button fx:id="btnRecHanoi" text="Tower of Hanoi" styleClass="btn-algo-action" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        <Button fx:id="btnRecBinSearch" text="Recursive Binary Search" styleClass="btn-algo-action" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    </HBox>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>

    <!-- Sticky Bottom Bar -->
    <bottom>
        <HBox alignment="CENTER" spacing="16" styleClass="sticky-bottom-bar">
            <padding>
                <Insets top="12" right="24" bottom="12" left="24"/>
            </padding>
            <Button fx:id="btnReturnHome" text="Return to Home Screen" styleClass="btn-bottom-return"/>
            <Button fx:id="btnExitApp" text="Exit App" styleClass="btn-bottom-exit"/>
        </HBox>
    </bottom>
</BorderPane>
